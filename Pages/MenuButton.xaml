<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiCustomControls.Pages.MenuButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiCustomControls.Views"
    Title="Menu Button"
    Padding="10,100">
    <VerticalStackLayout
        Spacing="8"
        VerticalOptions="Start">
        <Button
            Clicked="OnButtonClicked"
            HorizontalOptions="Center"
            Text="Menu" />
        <Border
            x:Name="Menu"
            HorizontalOptions="Center"
            IsVisible="False">
            <VerticalStackLayout
                Padding="10"
                Spacing="4">
                <views:MenuItem
                    Icon="steelpick.png"
                    Text="Mine" />
                <views:MenuItem
                    Icon="stonehoe.png"
                    Text="Farm" />
                <views:MenuItem
                    Icon="diamondsword.png"
                    Text="Fight" />
                <views:MenuItem
                    Icon="gold_ingot.png"
                    Text="Shop" />
                <views:MenuItem
                    Icon="rose.png"
                    Text="Love" />
                <views:MenuItem
                    Icon="sign.png"
                    Text="Share" />
                <views:MenuItem
                    Icon="book.png"
                    Text="Learn" />
                <views:MenuItem
                    Icon="apple.png"
                    Text="Eat" />
            </VerticalStackLayout>

        </Border>
    </VerticalStackLayout>
</ContentPage>