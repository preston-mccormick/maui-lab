<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiCustomControls.Pages.MenuButtonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiCustomControls.Controls"
    xmlns:vm="clr-namespace:MauiCustomControls.ViewModels"
    x:Name="This"
    Title="Menu Button"
    Padding="30"
    x:DataType="vm:MenuButtonViewModel">

    <Grid
        ColumnDefinitions="*,*"
        RowDefinitions="*,*,*">

        <!--  Completed MenuButton control with a popup action menu  -->
        <controls:MenuButton
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="16"
            BackgroundColor="Aquamarine"
            BindingContext="{Binding .}"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Items="{Binding Items}"
            Text="MenuButton Control"
            TextColor="{AppThemeBinding Dark=Black,
                                        Light=Black}"
            VerticalOptions="Start" />

        <!--  CompositeMenuButton control with a popup action menu  -->
        <controls:CompositeMenuButton
            Grid.Row="1"
            Grid.Column="0"
            BindingContext="{Binding .}"
            HorizontalOptions="Center"
            Items="{Binding Items}"
            Text="MenuButton Control"
            VerticalOptions="Start" />

        <!--  Popup Prototype  -->
        <VerticalStackLayout
            Grid.Row="1"
            Grid.Column="1"
            VerticalOptions="Start"
            WidthRequest="250">
            <Button
                Clicked="PopupMenuButtonClicked"
                HorizontalOptions="Center"
                Text="Popup Prototype"
                VerticalOptions="Center" />
        </VerticalStackLayout>

        <!--  Bindable Menu Prototype  -->
        <VerticalStackLayout
            Grid.Row="2"
            Grid.Column="0"
            VerticalOptions="Start"
            WidthRequest="250">
            <Button
                Clicked="BindableMenuButtonClicked"
                HorizontalOptions="Center"
                Text="Bindable Menu Prototype"
                VerticalOptions="Center" />
            <controls:Menu
                x:Name="Menu2"
                BindingContext="{Binding .}"
                HorizontalOptions="Center"
                IsVisible="False"
                Items="{Binding Items}"
                VerticalOptions="End" />
        </VerticalStackLayout>

        <!--  Bindable Menu Item Prototype  -->
        <VerticalStackLayout
            Grid.Row="2"
            Grid.Column="1"
            VerticalOptions="Start">
            <Button
                Clicked="MenuButtonClicked"
                HorizontalOptions="Center"
                Text="MenuItem Prototype" />
            <Border
                x:Name="Menu1"
                HorizontalOptions="Center"
                IsVisible="False">
                <VerticalStackLayout
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Dark=DimGray,
                                                      Light=White}"
                    Spacing="4">
                    <controls:MenuItem
                        Image="steelpick.png"
                        TapCommand="{Binding Source={x:Reference This}, Path=MenuItemCommand}"
                        Text="Mine" />
                    <controls:MenuItem
                        Image="stonehoe.png"
                        TapCommand="{Binding Source={x:Reference This}, Path=MenuItemCommand}"
                        Text="Farm" />
                    <controls:MenuItem
                        Image="diamondsword.png"
                        TapCommand="{Binding Source={x:Reference This}, Path=MenuItemCommand}"
                        Text="Fight" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>