<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiCustomControls.Controls.MenuButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiCustomControls.Controls">
    <VerticalStackLayout Spacing="5">
        <Button
            HorizontalOptions="Start"
            Text="{Binding Text}}" />
        <!--  Context Menu  -->
        <VerticalStackLayout
            HorizontalOptions="Start"
            IsVisible="{Binding IsMenuVisible}">
            <controls:MenuItem
                Icon="steelpick.png"
                TapCommand="{Binding MenuItemCommand}"
                TapCommandParameter="{Binding Source={RelativeSource Self}, Path=Text}"
                Text="Mine" />
            <controls:MenuItem
                Icon="stonehoe.png"
                TapCommand="{Binding MenuItemCommand}"
                Text="Farm" />
            <controls:MenuItem
                Icon="diamondsword.png"
                TapCommand="{Binding MenuItemCommand}"
                Text="Fight" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
