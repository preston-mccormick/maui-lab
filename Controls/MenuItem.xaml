<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiCustomControls.Controls.MenuItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiCustomControls.Controls"
    x:DataType="controls:MenuItem"
    BackgroundColor="MistyRose">
    <HorizontalStackLayout
        Padding="3"
        Spacing="10">
        <Image
            HeightRequest="20"
            HorizontalOptions="Center"
            Source="{Binding Icon}"
            VerticalOptions="Center"
            WidthRequest="20" />
        <Label
            HorizontalOptions="Center"
            Text="{Binding Label}"
            VerticalOptions="Center" />
    </HorizontalStackLayout>
</ContentView>
