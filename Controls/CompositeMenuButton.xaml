<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiCustomControls.Controls.CompositeMenuButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiCustomControls.Controls"
    x:Name="This"
    x:DataType="controls:MenuButton">
    <Button
        Clicked="ButtonClicked"
        HorizontalOptions="Start"
        ImageSource="{Binding Source={x:Reference This}, Path=Icon}"
        Text="{Binding Source={x:Reference This}, Path=Text}" />
</ContentView>