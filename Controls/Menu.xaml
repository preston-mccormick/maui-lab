<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiCustomControls.Controls.Menu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:MauiCustomControls.Controls"
    x:Name="This">
    <VerticalStackLayout
        Padding="12"
        BackgroundColor="{AppThemeBinding Dark=DimGray,
                                          Light=White}"
        BindableLayout.ItemsSource="{Binding Source={x:Reference This}, Path=Items}"
        Spacing="4">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <controls:MenuItem
                    AfterTap="{Binding Source={x:Reference This}, Path=AfterItemTap}"
                    BeforeTap="{Binding Source={x:Reference This}, Path=BeforeItemTap}"
                    Icon="{Binding Icon}"
                    TapCommand="{Binding TapCommand}"
                    Text="{Binding Text}" />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>