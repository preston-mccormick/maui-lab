<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiCustomControls.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiCustomControls.Controls"
    xmlns:local="clr-namespace:MauiCustomControls"
    x:DataType="local:MainPage">

    <VerticalStackLayout
        Padding="20"
        Spacing="10"
        VerticalOptions="Start">

        <Button
            Command="{Binding ShowAlertCommand}"
            HorizontalOptions="Center"
            Text="Show Alert" />
        <Button
            Command="{Binding ShowActionSheetCommand}"
            HorizontalOptions="Center"
            Text="Show ActionSheet" />
        <Button
            Command="{Binding ShowPromptCommand}"
            HorizontalOptions="Center"
            Text="Show Prompt" />
    </VerticalStackLayout>

</ContentPage>
