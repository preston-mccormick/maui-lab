<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiCustomControls.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MauiCustomControls.Pages"
    Title="MAUI Custom Control Lab"
    Shell.FlyoutBehavior="Locked">
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:Home}"
        Route="Home" />
    <ShellContent
        Title="Dialogs"
        ContentTemplate="{DataTemplate pages:Dialogs}"
        Route="Dialogs" />
    <ShellContent
        Title="Menu Button"
        ContentTemplate="{DataTemplate pages:MenuButton}"
        Route="MenuButton" />
    <ShellContent
        Title="Popup Menu Button"
        ContentTemplate="{DataTemplate pages:PopupMenu}"
        Route="PopupMenu" />
</Shell>
