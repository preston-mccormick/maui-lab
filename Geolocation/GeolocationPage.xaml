<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiCustomControls.Geolocation.GeolocationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gloc="using:MauiCustomControls.Geolocation"
    Title="Geolocation"
    x:DataType="gloc:GeolocationViewModel">
    <VerticalStackLayout>
        <Label FontSize="25" Text="Last Location" />
        <Label Text="{Binding Path=LastLocation.Latitude, StringFormat='Latitude: {0}'}" />
        <Label Text="{Binding Path=LastLocation.Longitude, StringFormat='Longitude: {0}'}" />
        <Label Text="{Binding Path=LastLocation.Altitude, StringFormat='Altitude: {0}'}" />
    </VerticalStackLayout>
</ContentPage>