<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Collections.CollectionViewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    xmlns:local="clr-namespace:MauiLab.Collections"
    Title="CollectionView Grid Layout"
    x:DataType="local:CollectionViewPageModel">
    <layouts:LayoutPlayground
        Title="Playground"
        AboutText="{Binding KindSummary}"
        AboutTitle="{Binding KindTitle}"
        AboutTapped="OnAboutTapped">
        <layouts:LayoutPlayground.Canvas>
            <Grid BackgroundColor="{Binding CanvasColor}">
                <CollectionView
                    x:Name="ItemsView"
                    ItemSizingStrategy="{Binding Sizing}"
                    ItemsUpdatingScrollMode="{Binding ScrollMode}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:SwatchItem">
                            <local:SwatchView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="local:SwatchGroup">
                            <Label
                                Margin="12,8"
                                FontAttributes="Bold"
                                Text="{Binding Letter}" />
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                </CollectionView>
                <local:TimingNotice />
            </Grid>
        </layouts:LayoutPlayground.Canvas>
        <layouts:LayoutPlayground.Toolbar>
            <local:CollectionToolbar />
        </layouts:LayoutPlayground.Toolbar>
        <layouts:LayoutPlayground.Panel>
            <VerticalStackLayout Spacing="12">
                <local:CollectionDataSection />
                <layouts:LeversSection Title="CollectionView">
                    <layouts:LeversSection.Body>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Orientation" VerticalOptions="Center" />
                                <Picker x:Name="OrientationPicker" Grid.Column="1" SelectedIndexChanged="OnOrientationChanged" />
                            </Grid>
                            <layouts:SettingSeparator />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                <Label Text="Span" VerticalOptions="Center" />
                                <layouts:NumberLever
                                    Grid.Column="1"
                                    Committed="OnSpanCommitted"
                                    Maximum="8"
                                    Minimum="1"
                                    Value="{Binding SpanEdit}" />
                                <layouts:InfoControl
                                    Grid.Column="2"
                                    InfoTapped="OnInfoTapped"
                                    Text="Span is how many items sit along the cross axis. A vertical grid counts columns. A horizontal grid counts rows."
                                    Title="Span" />
                            </Grid>
                            <layouts:SettingSeparator />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                <Label Text="Horizontal spacing" VerticalOptions="Center" />
                                <layouts:NumberLever
                                    Grid.Column="1"
                                    Committed="OnHorizontalSpacingCommitted"
                                    Maximum="64"
                                    Minimum="0"
                                    Value="{Binding HorizontalSpacing}" />
                            </Grid>
                            <layouts:SettingSeparator />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                <Label Text="Vertical spacing" VerticalOptions="Center" />
                                <layouts:NumberLever
                                    Grid.Column="1"
                                    Committed="OnVerticalSpacingCommitted"
                                    Maximum="64"
                                    Minimum="0"
                                    Value="{Binding VerticalSpacing}" />
                            </Grid>
                            <layouts:SettingSeparator />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="Sizing" VerticalOptions="Center" />
                                <Picker x:Name="SizingPicker" Grid.Column="1" SelectedIndexChanged="OnSizingChanged" />
                                <layouts:InfoControl
                                    Grid.Column="2"
                                    InfoTapped="OnInfoTapped"
                                    Text="Measure first uses the first row's size for every row. Measure all measures each row, and the correction can animate while the page is appearing."
                                    Title="Sizing" />
                            </Grid>
                            <layouts:SettingSeparator />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Grouping" VerticalOptions="Center" />
                                <Switch
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    IsToggled="{Binding IsGrouped, Mode=OneWay}"
                                    Toggled="OnGroupingToggled" />
                            </Grid>
                            <layouts:SettingSeparator />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="Scroll" VerticalOptions="Center" />
                                <Picker x:Name="ScrollPicker" Grid.Column="1" SelectedIndexChanged="OnScrollChanged" />
                                <layouts:InfoControl
                                    Grid.Column="2"
                                    InfoTapped="OnInfoTapped"
                                    Text="Where the list stays when the items are replaced, such as a sort or a catalog change. Keep offset keeps the scroll position. Keep item keeps the first visible item on screen. Keep last keeps the last item in view."
                                    Title="Scroll" />
                            </Grid>
                        </VerticalStackLayout>
                    </layouts:LeversSection.Body>
                </layouts:LeversSection>
                <local:CollectionItemSection />
            </VerticalStackLayout>
        </layouts:LayoutPlayground.Panel>
    </layouts:LayoutPlayground>
</ContentPage>
