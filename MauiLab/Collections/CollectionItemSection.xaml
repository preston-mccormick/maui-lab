<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.Collections.CollectionItemSection"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    xmlns:local="clr-namespace:MauiLab.Collections"
    x:DataType="local:CollectionPageModel">
    <layouts:LeversSection Title="Item">
        <layouts:LeversSection.Body>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="Arrangement" VerticalOptions="Center" />
                    <Picker
                        x:Name="ArrangementPicker"
                        Grid.Column="1"
                        SelectedIndexChanged="OnArrangementChanged"
                        Unfocused="OnArrangementClosed" />
                    <layouts:InfoControl
                        Grid.Column="2"
                        InfoTapped="OnInfoTapped"
                        Text="Card stacks the name three times and uses the height setting. Row is one line, 44 points tall, and ignores height. Varied gives each color its own width and height, from a fixed set large enough to read the name, and ignores the width and height settings."
                        Title="Arrangement" />
                </Grid>
                <layouts:SettingSeparator />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <Label IsEnabled="{Binding WidthApplies}" Text="Width" VerticalOptions="Center" />
                    <layouts:NumberLever
                        Grid.Column="1"
                        Committed="OnWidthCommitted"
                        IsEnabled="{Binding WidthApplies}"
                        Maximum="400"
                        Minimum="40"
                        Value="{Binding ItemWidth}" />
                </Grid>
                <layouts:SettingSeparator />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <Label IsEnabled="{Binding HeightApplies}" Text="Height" VerticalOptions="Center" />
                    <layouts:NumberLever
                        Grid.Column="1"
                        Committed="OnHeightCommitted"
                        IsEnabled="{Binding HeightApplies}"
                        Maximum="400"
                        Minimum="24"
                        Value="{Binding ItemHeight}" />
                </Grid>
                <layouts:SettingSeparator />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <Label Text="Font" VerticalOptions="Center" />
                    <layouts:NumberLever
                        Grid.Column="1"
                        Committed="OnFontCommitted"
                        Maximum="40"
                        Minimum="8"
                        Value="{Binding FontSize}" />
                </Grid>
                <layouts:SettingSeparator />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <Label Text="Margin" VerticalOptions="Center" />
                    <layouts:NumberLever
                        Grid.Column="1"
                        Committed="OnMarginCommitted"
                        Maximum="64"
                        Minimum="0"
                        Value="{Binding Margin}" />
                </Grid>
            </VerticalStackLayout>
        </layouts:LeversSection.Body>
    </layouts:LeversSection>
</ContentView>
