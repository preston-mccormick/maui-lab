<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.Collections.CollectionDataSection"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    xmlns:local="clr-namespace:MauiLab.Collections"
    x:DataType="local:CollectionPageModel">
    <layouts:LeversSection Title="Data">
        <layouts:LeversSection.Body>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="Catalog" VerticalOptions="Center" />
                    <Picker
                        x:Name="CatalogPicker"
                        Grid.Column="1"
                        ItemsSource="{Binding Catalogs}"
                        SelectedIndexChanged="OnCatalogChanged"
                        Unfocused="OnCatalogClosed" />
                </Grid>
                <layouts:SettingSeparator />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="Sort" VerticalOptions="Center" />
                    <Picker
                        x:Name="SortPicker"
                        Grid.Column="1"
                        ItemsSource="{Binding SortOptions}"
                        SelectedIndexChanged="OnSortChanged"
                        Unfocused="OnSortClosed" />
                </Grid>
            </VerticalStackLayout>
        </layouts:LeversSection.Body>
    </layouts:LeversSection>
</ContentView>
