<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.StartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    Padding="30,110">
    <Grid>
        <VerticalStackLayout
            x:Name="Hero"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Label
                x:Name="WelcomeLabel"
                Margin="0,0,0,-20"
                FontSize="30"
                Text="Welcome to"
                TextColor="{StaticResource Primary}"
                VerticalTextAlignment="Center" />
            <HorizontalStackLayout
                x:Name="TitleRow"
                Margin="100,0,0,0"
                HorizontalOptions="Center"
                Spacing="8"
                VerticalOptions="Start">
                <Label
                    x:Name="TitleLabel"
                    FontSize="75"
                    Text="MAUI Lab"
                    TextColor="{StaticResource LightPrimary}"
                    VerticalTextAlignment="Center" />
                <Image
                    x:Name="Flask"
                    HeightRequest="150"
                    Source="chemistry_flask.png"
                    WidthRequest="150" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
