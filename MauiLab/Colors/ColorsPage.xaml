<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Colors.ColorsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="using:MauiLab.Colors"
    Title="{Binding Title}"
    x:DataType="local:ColorsPageModel">
    <Grid RowDefinitions="Auto, *">
        <HorizontalStackLayout Padding="8" Spacing="24">
            <Picker
                Title="UI Strategy"
                Grid.Row="0"
                ItemsSource="{Binding UpdateSwatchesStrategy}"
                SelectedItem="{Binding SelectedUpdateSwatchesStrategy}" />
            <Picker
                Title="Sort By"
                Grid.Row="0"
                ItemDisplayBinding="{Binding Name}"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}" />
        </HorizontalStackLayout>
        <local:SwatchesView Grid.Row="1" />
    </Grid>
</ContentPage>