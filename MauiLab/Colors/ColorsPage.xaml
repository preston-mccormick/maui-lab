<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Colors.ColorsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="using:MauiLab.Colors"
    Title="{Binding Title}"
    x:DataType="local:ColorsPageModel">
    <Grid RowDefinitions="Auto, *">
        <Grid
            x:Name="ToolBar"
            Padding="12,8"
            ColumnDefinitions="*,*,Auto,Auto"
            ColumnSpacing="12"
            RowDefinitions="Auto"
            RowSpacing="8"
            SizeChanged="OnToolBarSizeChanged">
            <Grid
                x:Name="ListGroup"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
                <Label Text="List" VerticalOptions="Center" />
                <Picker
                    Title="List"
                    Grid.Column="1"
                    HorizontalOptions="Fill"
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding ColorLists}"
                    SelectedIndexChanged="OnPickerSelectedIndexChanged"
                    SelectedItem="{Binding SelectedColorList}" />
            </Grid>
            <Grid
                x:Name="SortGroup"
                Grid.Column="1"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
                <Label Text="Sort" VerticalOptions="Center" />
                <Picker
                    Title="Sort By"
                    Grid.Column="1"
                    HorizontalOptions="Fill"
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding SortOptions}"
                    SelectedIndexChanged="OnPickerSelectedIndexChanged"
                    SelectedItem="{Binding SelectedSortOption}" />
            </Grid>
            <Grid
                x:Name="FontGroup"
                Grid.Column="2"
                ColumnDefinitions="Auto,140,32"
                ColumnSpacing="8">
                <Label Text="Font" VerticalOptions="Center" />
                <Slider
                    Grid.Column="1"
                    Maximum="40"
                    Minimum="8"
                    Value="{Binding FontSizePreview}"
                    DragCompleted="OnFontDragCompleted"
                    DragStarted="OnFontDragStarted"
                    ValueChanged="OnFontValueChanged"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="2"
                    Text="{Binding FontSizeText}"
                    VerticalOptions="Center" />
            </Grid>
            <Button
                x:Name="ResetButton"
                Grid.Column="3"
                Clicked="OnResetClicked"
                HorizontalOptions="End"
                Text="Reset"
                VerticalOptions="Center" />
        </Grid>
        <local:SwatchesView Grid.Row="1" />
    </Grid>
</ContentPage>
