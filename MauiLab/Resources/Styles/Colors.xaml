<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

    <Color x:Key="LightText">#F1F1F1</Color>
    <Color x:Key="DarkText">#000000</Color>
    <Color x:Key="DisabledText">#808080</Color>
    <Color x:Key="LightBackground">#FFFFFF</Color>
    <Color x:Key="DarkBackground">#222222</Color>

    <Color x:Key="LightPrimary">#B1E0E6</Color>
    <Color x:Key="Primary">#78CDD4</Color>
    <Color x:Key="DarkPrimary">#44B9C4</Color>

    <Color x:Key="LightSecondary">#FFE5FF</Color>
    <Color x:Key="Secondary">#FEA8FF</Color>
    <Color x:Key="DarkSecondary">#FC49FF</Color>

    <Color x:Key="LightTertiary">#E9F4DD</Color>
    <Color x:Key="Tertiary">#B8DC95</Color>
    <Color x:Key="DarkTertiary">#6FA738</Color>

    <Color x:Key="UsageNavigation">#1D4ED8</Color>
    <Color x:Key="UsageNavigationOnDark">#93C5FD</Color>
    <Color x:Key="UsageScreen">#3F7D1F</Color>
    <Color x:Key="UsageScreenOnDark">#B8DC95</Color>
    <Color x:Key="UsageLifecycle">#C026D3</Color>
    <Color x:Key="UsageLifecycleOnDark">#F5A8FF</Color>
    <Color x:Key="UsageAction">#C2410C</Color>
    <Color x:Key="UsageActionOnDark">#FDBA74</Color>
    <Color x:Key="UsagePermission">#6D28D9</Color>
    <Color x:Key="UsagePermissionOnDark">#C4B5FD</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="LighterGray">#CCCCCC</Color>
    <Color x:Key="LightGray">#AAAAAA</Color>
    <Color x:Key="Gray">#808080</Color>
    <Color x:Key="DarkGray">#555555</Color>
    <Color x:Key="DarkerGray">#333333</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="DarkerGrayBrush" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="DarkGrayBrush" Color="{StaticResource DarkGray}" />
    <SolidColorBrush x:Key="GrayBrush" Color="{StaticResource Gray}" />
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGray}" />
    <SolidColorBrush x:Key="LighterGrayBrush" Color="{StaticResource LighterGray}" />
</ResourceDictionary>