<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

    <Color x:Key="Primary">#78cdd4</Color>
    <Color x:Key="Secondary">#b1e0e6</Color>

    <Color x:Key="LightText">#f1f1f1</Color>
    <Color x:Key="DarkText">#000000</Color>
    <Color x:Key="DisabledLightText">#808080</Color>
    <Color x:Key="DisabledDarkText">#808080</Color>

    <Color x:Key="LightBackground">#ffffff</Color>
    <Color x:Key="DarkBackground">#222222</Color>

    <Color x:Key="Blue1">#b1e0e6</Color>
    <Color x:Key="Blue2">#78cdd4</Color>
    <Color x:Key="Green1">#e7fee5</Color>
    <Color x:Key="Green2">#b8dc95</Color>
    <Color x:Key="Pink1">#fed5ff</Color>
    <Color x:Key="Pink2">#feA8Ff</Color>

    <Color x:Key="Magenta">#d600aa</Color>

    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="LighterGray">#cccccc</Color>
    <Color x:Key="LightGray">#999999</Color>
    <Color x:Key="Gray">#808080</Color>
    <Color x:Key="DarkGray">#666666</Color>
    <Color x:Key="DarkerGray">#333333</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="DarkerGrayBrush" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="DarkGrayBrush" Color="{StaticResource DarkGray}" />
    <SolidColorBrush x:Key="GrayBrush" Color="{StaticResource Gray}" />
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGray}" />
    <SolidColorBrush x:Key="LighterGrayBrush" Color="{StaticResource LighterGray}" />
</ResourceDictionary>