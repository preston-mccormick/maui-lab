<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Geolocation.GeolocationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gloc="using:MauiLab.Geolocation"
    Title="Geolocation"
    x:DataType="gloc:GeolocationViewModel">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label FontSize="25" Text="Cached Location" />
        <Label Text="{Binding Path=LastLocation.Latitude, StringFormat='Latitude: {0}'}" />
        <Label Text="{Binding Path=LastLocation.Longitude, StringFormat='Longitude: {0}'}" />
        <Label Text="{Binding Path=LastLocation.Altitude, StringFormat='Altitude: {0}'}" />
        <Label FontSize="25" Text="Current Location" />
        <Label Text="{Binding Path=CurrentLocation.Latitude, StringFormat='Latitude: {0}'}" />
        <Label Text="{Binding Path=CurrentLocation.Longitude, StringFormat='Longitude: {0}'}" />
        <Label Text="{Binding Path=CurrentLocation.Altitude, StringFormat='Altitude: {0}'}" />
    </VerticalStackLayout>
</ContentPage>