<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Geolocation.GeolocationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gloc="using:MauiLab.Geolocation"
    Title="Geolocation"
    x:DataType="gloc:GeolocationViewModel">
    <VerticalStackLayout Padding="12" Spacing="12">
        <Label FontSize="25" Text="Location" />
        <Label Text="{Binding LastLocation.Accuracy, StringFormat='Accuracy: {0}'}" />
        <Label Text="{Binding LastLocation.Latitude, StringFormat='Latitude: {0}'}" />
        <Label Text="{Binding LastLocation.Longitude, StringFormat='Longitude: {0}'}" />
        <Label Text="{Binding LastLocation.Timestamp, StringFormat='Timestamp: {0:G}'}" />
        <HorizontalStackLayout Spacing="12">
            <Button Command="{Binding UpdateLocationCommand}" Text="Update" />
            <Button Command="{Binding StartListeningCommand}" Text="Start Listening" />
            <Button Command="{Binding StopListeningCommand}" Text="Stop Listening" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>