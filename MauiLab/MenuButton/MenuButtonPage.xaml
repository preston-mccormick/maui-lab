<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.MenuButton.MenuButtonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="using:MauiLab.MenuButton.Controls"
    xmlns:vm="clr-namespace:MauiLab.ViewModels"
    Title="Menu Button"
    Padding="24"
    x:DataType="vm:MenuButtonViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="controls:MenuButton">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Default={StaticResource DarkText}}" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Default={StaticResource Primary}}" />
                <Setter Property="FontFamily"
                        Value="OpenSansRegular" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="BorderWidth"
                        Value="0" />
                <Setter Property="CornerRadius"
                        Value="8" />
                <Setter Property="Padding"
                        Value="16,12" />
                <Setter Property="Margin"
                        Value="6" />
                <Setter Property="MinimumHeightRequest"
                        Value="44" />
                <Setter Property="MinimumWidthRequest"
                        Value="44" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Default={StaticResource Primary}}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Default={StaticResource DarkText}}" />
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Default={StaticResource Gray}}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Default={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
                <Setter Property="Items" Value="{Binding Items}" />
                <Setter Property="Text" Value="{Binding Text}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <!--  Completed MenuButton control with a popup action menu  -->
        <controls:MenuButton x:Name="TopLeft" HorizontalOptions="Start" VerticalOptions="Start" />
        <controls:MenuButton x:Name="MiddleLeft" HorizontalOptions="Start" VerticalOptions="Center" />
        <controls:MenuButton x:Name="BottomLeft" HorizontalOptions="Start" VerticalOptions="End" />
        <controls:MenuButton x:Name="TopCenter" HorizontalOptions="Center" VerticalOptions="Start" />
        <controls:MenuButton x:Name="MiddleCenter" HorizontalOptions="Center" VerticalOptions="Center" />
        <controls:MenuButton x:Name="BottomCenter" HorizontalOptions="Center" VerticalOptions="End" />
        <controls:MenuButton x:Name="TopRight" HorizontalOptions="End" VerticalOptions="Start" />
        <controls:MenuButton x:Name="MiddleRight" HorizontalOptions="End" VerticalOptions="Center" />
        <controls:MenuButton x:Name="BottomRight" HorizontalOptions="End" VerticalOptions="End" />
    </Grid>
</ContentPage>