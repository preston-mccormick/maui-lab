<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.MenuButton.MenuButtonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="using:MauiLab.MenuButton.Controls"
    xmlns:vm="clr-namespace:MauiLab.ViewModels"
    Title="Menu Button"
    Padding="24"
    x:DataType="vm:MenuButtonViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style BasedOn="{StaticResource button-default}" TargetType="controls:MenuButton">
                <Setter Property="Items" Value="{Binding Items}" />
                <Setter Property="Text" Value="Menu Button" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <!--  Completed MenuButton control with a popup action menu  -->
        <controls:MenuButton HorizontalOptions="Start" VerticalOptions="Start" />
        <controls:MenuButton HorizontalOptions="Start" VerticalOptions="Center" />
        <controls:MenuButton HorizontalOptions="Start" VerticalOptions="End" />
        <controls:MenuButton HorizontalOptions="Center" VerticalOptions="Start" />
        <controls:MenuButton HorizontalOptions="Center" VerticalOptions="Center" />
        <controls:MenuButton HorizontalOptions="Center" VerticalOptions="End" />
        <controls:MenuButton HorizontalOptions="End" VerticalOptions="Start" />
        <controls:MenuButton HorizontalOptions="End" VerticalOptions="Center" />
        <controls:MenuButton HorizontalOptions="End" VerticalOptions="End" />
    </Grid>
</ContentPage>