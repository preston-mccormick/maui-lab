<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="MauiLab.Views.StaticMenuPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiLab.MenuButton.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <VerticalStackLayout
        Padding="10"
        BackgroundColor="{AppThemeBinding Dark=DimGray,
                                          Light=White}"
        Spacing="4">
        <controls:MenuItem
            Image="steelpick.png"
            Text="Mine" />
        <controls:MenuItem
            Image="stonehoe.png"
            Text="Farm" />
        <controls:MenuItem
            Image="diamondsword.png"
            Text="Fight" />
        <controls:MenuItem
            Image="gold_ingot.png"
            Text="Shop" />
        <controls:MenuItem
            Image="rose.png"
            Text="Love" />
        <controls:MenuItem
            Image="sign.png"
            Text="Share" />
        <controls:MenuItem
            Image="book.png"
            Text="Learn" />
        <controls:MenuItem
            Image="apple.png"
            Text="Eat" />
    </VerticalStackLayout>
</toolkit:Popup>