<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.MenuButton.Controls.MenuItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiLab.Controls">
    <HorizontalStackLayout
        Padding="3"
        Spacing="10">
        <HorizontalStackLayout.GestureRecognizers>
            <TapGestureRecognizer
                NumberOfTapsRequired="1"
                Tapped="Tapped" />
        </HorizontalStackLayout.GestureRecognizers>
        <Image
            x:Name="ItemImage"
            HeightRequest="32"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="32" />
        <Label
            x:Name="ItemLabel"
            FontSize="20"
            HorizontalOptions="Center"
            TextColor="{AppThemeBinding Default={StaticResource DarkText},
                                        Dark={StaticResource LightText}}"
            VerticalOptions="Center" />
    </HorizontalStackLayout>
</ContentView>