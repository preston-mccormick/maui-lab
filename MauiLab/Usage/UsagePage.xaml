<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Usage.UsagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:usage="using:MauiLab.Usage"
    Title="Usage"
    x:DataType="usage:UsagePageModel">
    <Grid Padding="12,12,12,0" RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label FontSize="25" Text="Usage" />
                <Label
                    FontSize="14"
                    Text="Sessions, pages, and time in the foreground."
                    TextColor="{AppThemeBinding Default={StaticResource DarkGray}, Dark={StaticResource LighterGray}}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="1"
                Command="{Binding ResetCommand}"
                Text="Reset"
                VerticalOptions="Center" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Rows}"
            ItemsUpdatingScrollMode="KeepScrollOffset"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usage:TimelineRow">
                    <Grid Padding="0" ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <usage:UsageRailView
                            Grid.ColumnSpan="2"
                            HorizontalOptions="Fill"
                            Rail="{Binding Rail}"
                            VerticalOptions="Fill" />
                        <VerticalStackLayout Margin="{Binding TextIndent}" Spacing="1" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{Binding Title}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding Category}" TargetType="Label" Value="Navigation">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Default={StaticResource UsageNavigation}, Dark={StaticResource UsageNavigationOnDark}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" TargetType="Label" Value="Screen">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Default={StaticResource UsageScreen}, Dark={StaticResource UsageScreenOnDark}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" TargetType="Label" Value="Lifecycle">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Default={StaticResource UsageLifecycle}, Dark={StaticResource UsageLifecycleOnDark}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" TargetType="Label" Value="Action">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Default={StaticResource UsageAction}, Dark={StaticResource UsageActionOnDark}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" TargetType="Label" Value="Permission">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Default={StaticResource UsagePermission}, Dark={StaticResource UsagePermissionOnDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label
                                FontSize="13"
                                IsVisible="{Binding HasDetail}"
                                Text="{Binding Detail}"
                                TextColor="{AppThemeBinding Default={StaticResource DarkGray}, Dark={StaticResource LighterGray}}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            FontSize="13"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            Text="{Binding When}"
                            TextColor="{AppThemeBinding Default={StaticResource DarkGray}, Dark={StaticResource LighterGray}}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
