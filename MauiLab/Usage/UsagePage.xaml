<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Usage.UsagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:usage="using:MauiLab.Usage"
    Title="Usage"
    x:DataType="usage:UsagePageModel">
    <ContentPage.Resources>
        <usage:CategoryColorConverter x:Key="CategoryColor" />
    </ContentPage.Resources>
    <Grid Padding="12,12,12,0" RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label FontSize="25" Text="Usage" />
                <Label
                    FontSize="14"
                    Text="Sessions, pages, and time in the foreground."
                    TextColor="{AppThemeBinding Default={StaticResource DarkGray}, Dark={StaticResource LighterGray}}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="1"
                Command="{Binding ResetCommand}"
                Text="Reset"
                VerticalOptions="Center" />
        </Grid>

        <!--
            Rows are a fixed 44pt and the list measures one item. Self-sizing cells (MeasureAllItems)
            lay out from an estimate and then grow to their real size, and because that happens during
            the Shell transition the growth animates: rows appeared squeezed, then spread out.
        -->
        <CollectionView
            Grid.Row="1"
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding Rows}"
            ItemsUpdatingScrollMode="KeepScrollOffset"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usage:TimelineRow">
                    <Grid Padding="0" ColumnDefinitions="*,Auto" HeightRequest="44">
                        <usage:UsageRailView
                            Grid.ColumnSpan="2"
                            HorizontalOptions="Fill"
                            Rail="{Binding Rail}"
                            VerticalOptions="Fill" />
                        <VerticalStackLayout Margin="{Binding TextIndent, Mode=OneTime}" Spacing="1" VerticalOptions="Center">
                            <!--  Title, indent and time never change for a given row, so they bind once.  -->
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Title, Mode=OneTime}"
                                TextColor="{Binding Category, Mode=OneTime, Converter={StaticResource CategoryColor}}" />
                            <Label
                                FontSize="13"
                                IsVisible="{Binding HasDetail}"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Detail}"
                                TextColor="{AppThemeBinding Default={StaticResource DarkGray}, Dark={StaticResource LighterGray}}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            FontSize="13"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            LineBreakMode="NoWrap"
                            Text="{Binding When, Mode=OneTime}"
                            TextColor="{AppThemeBinding Default={StaticResource DarkGray}, Dark={StaticResource LighterGray}}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
