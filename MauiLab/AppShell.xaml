<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiLab.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:colors="using:MauiLab.Colors"
    xmlns:dialogs="using:MauiLab.Dialogs"
    xmlns:editor="using:MauiLab.Editor"
    xmlns:gloc="using:MauiLab.Geolocation"
    xmlns:lab="using:MauiLab"
    xmlns:layouts="using:MauiLab.Layouts"
    xmlns:mb="using:MauiLab.MenuButton"
    Title="MAUI Lab"
    Shell.FlyoutBehavior="{OnIdiom Phone=Flyout,
                                   Default=Locked}">
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate lab:StartPage}"
        Route="home" />
    <ShellContent
        Title="Dialogs"
        ContentTemplate="{DataTemplate dialogs:DialogsPage}"
        Route="dialogs" />
    <ShellContent
        Title="Menu Button"
        ContentTemplate="{DataTemplate mb:MenuButtonPage}"
        Route="popup-menu" />
    <ShellContent
        Title="Geolocation"
        ContentTemplate="{DataTemplate gloc:GeolocationPage}"
        Route="geolocation" />
    <ShellContent
        Title="Colors"
        ContentTemplate="{DataTemplate colors:ColorsPage}"
        Route="colors" />
    <ShellContent
        Title="Editor Bug"
        ContentTemplate="{DataTemplate editor:EditorBugPage}"
        Route="editor-bug" />
    <ShellContent
        Title="Dialog Layout"
        ContentTemplate="{DataTemplate layouts:DialogLayoutPage}"
        Route="layouts-dialog" />
    <ShellContent
        Title="Scrolling Layout"
        ContentTemplate="{DataTemplate layouts:ScrollingLayoutPage}"
        Route="layouts-scrollviw" />
</Shell>
