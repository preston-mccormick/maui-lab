<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiLab.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:colors="using:MauiLab.Colors"
    xmlns:dialogs="using:MauiLab.Dialogs"
    xmlns:gloc="using:MauiLab.Geolocation"
    xmlns:lab="using:MauiLab"
    xmlns:layouts="using:MauiLab.Layouts"
    xmlns:mb="using:MauiLab.MenuButton"
    Title="MAUI Lab"
    Shell.FlyoutBehavior="Flyout">
    <ShellContent Title="Home" ContentTemplate="{DataTemplate lab:StartPage}" />
    <ShellContent Title="Dialogs" ContentTemplate="{DataTemplate dialogs:DialogsPage}" />
    <ShellContent Title="Menu Button" ContentTemplate="{DataTemplate mb:MenuButtonPage}" />
    <ShellContent Title="Geolocation" ContentTemplate="{DataTemplate gloc:GeolocationPage}" />
    <ShellContent Title="Colors" ContentTemplate="{DataTemplate colors:ColorsPage}" />
    <ShellContent Title="Dialog Layout" ContentTemplate="{DataTemplate layouts:DialogLayoutPage}" />
    <ShellContent Title="Scrolling Layout" ContentTemplate="{DataTemplate layouts:ScrollingLayoutPage}" />
</Shell>
