<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiLab.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:collections="using:MauiLab.Collections"
    xmlns:contacts="using:MauiLab.Contacts"
    xmlns:colors="using:MauiLab.Colors"
    xmlns:dialogs="using:MauiLab.Dialogs"
    xmlns:forms="using:MauiLab.FormControls"
    xmlns:gloc="using:MauiLab.Geolocation"
    xmlns:lab="using:MauiLab"
    xmlns:layouts="using:MauiLab.Layouts"
    xmlns:mb="using:MauiLab.MenuButton"
    xmlns:usage="using:MauiLab.Usage"
    Title="MAUI Lab"
    Shell.FlyoutBehavior="Flyout">
    <ShellContent Title="Home" FlyoutIcon="{AppThemeBinding Light=science, Dark=science_dark}" ContentTemplate="{DataTemplate lab:StartPage}" />
    <ShellContent Title="Colors" FlyoutIcon="{AppThemeBinding Light=palette, Dark=palette_dark}" ContentTemplate="{DataTemplate colors:ColorsPage}" />
    <ShellContent Title="Contacts" FlyoutIcon="{AppThemeBinding Light=contacts, Dark=contacts_dark}" ContentTemplate="{DataTemplate contacts:ContactsPage}" />
    <FlyoutItem Title="Layouts" FlyoutIcon="{AppThemeBinding Light=dashboard, Dark=dashboard_dark}" Route="layouts">
        <ShellContent Title="Grid Layout" Icon="grid_on" ContentTemplate="{DataTemplate layouts:GridLayoutPage}" />
        <ShellContent Title="Absolute Layout" Icon="open_with" ContentTemplate="{DataTemplate layouts:AbsoluteLayoutPage}" />
        <ShellContent Title="Dock Layout" Icon="view_sidebar" ContentTemplate="{DataTemplate layouts:DockLayoutPage}" />
        <Tab Title="More Layouts" Icon="more_horiz">
            <ShellContent Title="Stack Layout" Icon="view_agenda" ContentTemplate="{DataTemplate layouts:StackLayoutPage}" />
            <ShellContent Title="Flex Layout" Icon="flex_direction" ContentTemplate="{DataTemplate layouts:FlexLayoutPage}" />
            <ShellContent Title="Composite Layout" Icon="layers" ContentTemplate="{DataTemplate layouts:CompositeLayoutPage}" />
            <ShellContent Title="Radial Layout" Icon="radar" ContentTemplate="{DataTemplate layouts:RadialLayoutPage}" />
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Collections" FlyoutIcon="{AppThemeBinding Light=dataset, Dark=dataset_dark}" Route="collections">
        <ShellContent Title="Grid" Icon="grid_view" ContentTemplate="{DataTemplate collections:CollectionViewPage}" />
        <ShellContent Title="Linear" Icon="view_list" ContentTemplate="{DataTemplate collections:LinearCollectionPage}" />
        <ShellContent Title="Flex" Icon="flex_wrap" ContentTemplate="{DataTemplate collections:FlexItemsPage}" />
        <ShellContent Title="Uniform" Icon="view_module" ContentTemplate="{DataTemplate collections:UniformItemsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Forms" FlyoutIcon="{AppThemeBinding Light=dynamic_form, Dark=dynamic_form_dark}" Route="forms">
        <ShellContent Title="Form Controls" Icon="edit_note" ContentTemplate="{DataTemplate forms:FormControlsPage}" />
        <ShellContent Title="Dialogs" Icon="picture_in_picture" ContentTemplate="{DataTemplate dialogs:DialogsPage}" />
        <ShellContent Title="Menu Button" Icon="more_vert" ContentTemplate="{DataTemplate mb:MenuButtonPage}" />
    </FlyoutItem>
    <ShellContent Title="Geolocation" FlyoutIcon="{AppThemeBinding Light=location_on, Dark=location_on_dark}" ContentTemplate="{DataTemplate gloc:GeolocationPage}" />
    <ShellContent Title="Usage" FlyoutIcon="{AppThemeBinding Light=timeline, Dark=timeline_dark}" ContentTemplate="{DataTemplate usage:UsagePage}" />
</Shell>
