<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiLab.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:colors="using:MauiLab.Colors"
    xmlns:dialogs="using:MauiLab.Dialogs"
    xmlns:forms="using:MauiLab.FormControls"
    xmlns:gloc="using:MauiLab.Geolocation"
    xmlns:lab="using:MauiLab"
    xmlns:layouts="using:MauiLab.Layouts"
    xmlns:mb="using:MauiLab.MenuButton"
    xmlns:usage="using:MauiLab.Usage"
    Title="MAUI Lab"
    Shell.FlyoutBehavior="Flyout">
    <ShellContent Title="Home" ContentTemplate="{DataTemplate lab:StartPage}" />
    <ShellContent Title="Colors" ContentTemplate="{DataTemplate colors:ColorsPage}" />
    <ShellContent Title="Form Controls" ContentTemplate="{DataTemplate forms:FormControlsPage}" />
    <FlyoutItem Title="Layouts" Route="layouts">
        <Tab Title="Layouts">
            <ShellContent Title="Grid Layout" ContentTemplate="{DataTemplate layouts:GridLayoutPage}" />
            <ShellContent Title="Stack Layout" ContentTemplate="{DataTemplate layouts:StackLayoutPage}" />
            <ShellContent Title="Absolute Layout" ContentTemplate="{DataTemplate layouts:AbsoluteLayoutPage}" />
            <ShellContent Title="Flex Layout" ContentTemplate="{DataTemplate layouts:FlexLayoutPage}" />
            <ShellContent Title="Composite Layout" ContentTemplate="{DataTemplate layouts:CompositeLayoutPage}" />
            <ShellContent Title="Dock Layout" ContentTemplate="{DataTemplate layouts:DockLayoutPage}" />
            <ShellContent Title="Radial Layout" ContentTemplate="{DataTemplate layouts:RadialLayoutPage}" />
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Experiments" Route="experiments">
        <ShellContent Title="Dialogs" ContentTemplate="{DataTemplate dialogs:DialogsPage}" />
        <ShellContent Title="Menu Button" ContentTemplate="{DataTemplate mb:MenuButtonPage}" />
        <ShellContent Title="Scrolling Layout" ContentTemplate="{DataTemplate layouts:ScrollingLayoutPage}" />
    </FlyoutItem>
    <ShellContent Title="Geolocation" ContentTemplate="{DataTemplate gloc:GeolocationPage}" />
    <ShellContent Title="Usage" ContentTemplate="{DataTemplate usage:UsagePage}" />
</Shell>
