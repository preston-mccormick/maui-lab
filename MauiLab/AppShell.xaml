<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiCustomControls.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gloc="using:MauiCustomControls.Geolocation"
    xmlns:pages="clr-namespace:MauiCustomControls.Pages"
    Title="MAUI Lab"
    Shell.FlyoutBehavior="Locked">
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:Home}"
        Route="home" />
    <ShellContent
        Title="Dialogs"
        ContentTemplate="{DataTemplate pages:DialogsPage}"
        Route="dialogs" />
    <ShellContent
        Title="Menu Button"
        ContentTemplate="{DataTemplate pages:MenuButtonPage}"
        Route="popup-menu" />
    <ShellContent
        Title="Geolocation"
        ContentTemplate="{DataTemplate gloc:GeolocationPage}"
        Route="geolocation" />
</Shell>
