<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Dialogs.DialogsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dialogs="clr-namespace:MauiLab.Dialogs"
    Title="Dialogs"
    Padding="30"
    x:DataType="dialogs:DialogsPage"
    BindingContext="{Binding Source={RelativeSource Self}}">
    <Grid ColumnDefinitions="*,*,*">

        <Button
            Grid.Column="0"
            Command="{Binding ShowAlertCommand}"
            HorizontalOptions="Center"
            Text="Show Alert"
            VerticalOptions="Start" />
        <Button
            Grid.Column="1"
            Command="{Binding ShowActionSheetCommand}"
            HorizontalOptions="Center"
            Text="Show ActionSheet"
            VerticalOptions="Start" />
        <Button
            Grid.Column="2"
            Command="{Binding ShowPromptCommand}"
            HorizontalOptions="Center"
            Text="Show Prompt"
            VerticalOptions="Start" />
    </Grid>

</ContentPage>