<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.Layouts.LeversSection"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    x:Name="This">
    <Border
        Margin="0,0,4,0"
        Padding="8"
        Style="{StaticResource floating-card}">
        <VerticalStackLayout Spacing="6">
        <Grid Padding="0,4">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderTapped" />
            </Grid.GestureRecognizers>
            <Label
                HorizontalOptions="Start"
                Style="{StaticResource Small}"
                Text="{Binding Source={x:Reference This}, Path=ExpandGlyph, x:DataType=layouts:LeversSection}"
                TextColor="{AppThemeBinding Default={StaticResource DarkTertiary},
                                            Dark={StaticResource Tertiary}}"
                VerticalOptions="Center" />
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource Small}"
                Text="{Binding Source={x:Reference This}, Path=Title, x:DataType=layouts:LeversSection}"
                TextColor="{AppThemeBinding Default={StaticResource DarkTertiary},
                                            Dark={StaticResource Tertiary}}"
                VerticalOptions="Center" />
        </Grid>
        <ContentView x:Name="BodyHost" IsVisible="{Binding Source={x:Reference This}, Path=IsExpanded, x:DataType=layouts:LeversSection}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
