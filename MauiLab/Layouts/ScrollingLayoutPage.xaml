<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Layouts.ScrollingLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Scrolling Layout">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label
            Margin="12"
            Style="{StaticResource Large}"
            Text="Header" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="12">
                <VerticalStackLayout.Resources>
                    <ResourceDictionary>
                        <Style TargetType="BoxView">
                            <Setter Property="HeightRequest" Value="60" />
                        </Style>
                        <LinearGradientBrush x:Key="SelectedGradient" EndPoint="1,0">
                            <GradientStop Offset="0.25" Color="Pink" />
                            <GradientStop Offset="0.25" Color="LightYellow" />
                            <GradientStop Offset="0.5" Color="LightYellow" />
                            <GradientStop Offset="0.5" Color="LightBlue" />
                            <GradientStop Offset="0.75" Color="LightBlue" />
                            <GradientStop Offset="0.75" Color="LightGreen" />
                            <GradientStop Offset="1" Color="LightGreen" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                </VerticalStackLayout.Resources>
                <BoxView Background="{StaticResource SelectedGradient}" />
                <BoxView BackgroundColor="Pink" />
                <BoxView BackgroundColor="LightYellow" />
                <BoxView BackgroundColor="LightBlue" />
                <BoxView BackgroundColor="LightGreen" />
                <BoxView Background="{StaticResource SelectedGradient}" />
                <BoxView BackgroundColor="Pink" />
                <BoxView BackgroundColor="LightYellow" />
                <BoxView BackgroundColor="LightBlue" />
                <BoxView BackgroundColor="LightGreen" />
                <BoxView Background="{StaticResource SelectedGradient}" />
                <BoxView BackgroundColor="Pink" />
                <BoxView BackgroundColor="LightYellow" />
                <BoxView BackgroundColor="LightBlue" />
                <BoxView BackgroundColor="LightGreen" />
                <BoxView Background="{StaticResource SelectedGradient}" />
                <BoxView BackgroundColor="Pink" />
                <BoxView BackgroundColor="LightYellow" />
                <BoxView BackgroundColor="LightBlue" />
                <BoxView BackgroundColor="LightGreen" />
                <BoxView Background="{StaticResource SelectedGradient}" />
                <BoxView BackgroundColor="Pink" />
                <BoxView BackgroundColor="LightYellow" />
                <BoxView BackgroundColor="LightBlue" />
                <BoxView BackgroundColor="LightGreen" />
            </VerticalStackLayout>
        </ScrollView>
        <Label
            Grid.Row="2"
            Margin="12"
            Style="{StaticResource Large}"
            Text="Footer" />
    </Grid>
</ContentPage>