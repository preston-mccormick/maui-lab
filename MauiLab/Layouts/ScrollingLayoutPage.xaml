<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Layouts.ScrollingLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Scrolling Layout">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label
            Margin="12"
            Style="{StaticResource Large}"
            Text="Header" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="12">
                <VerticalStackLayout.Resources>
                    <ResourceDictionary>
                        <Style TargetType="BoxView">
                            <Setter Property="HeightRequest" Value="60" />
                        </Style>
                        <LinearGradientBrush x:Key="Gradient1" EndPoint="1,0">
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="Gradient2" EndPoint="1,0">
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="Gradient3" EndPoint="1,0">
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="Gradient4" EndPoint="1,0">
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightGreen, Dark=ForestGreen}" />
                            <GradientStop Offset="0.25" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightBlue, Dark=SteelBlue}" />
                            <GradientStop Offset="0.5" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=LightYellow, Dark=DarkGoldenrod}" />
                            <GradientStop Offset="0.75" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                            <GradientStop Offset="1" Color="{AppThemeBinding Default=Pink, Dark=MediumVioletRed}" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                </VerticalStackLayout.Resources>
                <BoxView Background="{StaticResource Gradient1}" />
                <BoxView Background="{StaticResource Gradient2}" />
                <BoxView Background="{StaticResource Gradient3}" />
                <BoxView Background="{StaticResource Gradient4}" />
                <BoxView Background="{StaticResource Gradient1}" />
                <BoxView Background="{StaticResource Gradient2}" />
                <BoxView Background="{StaticResource Gradient3}" />
                <BoxView Background="{StaticResource Gradient4}" />
                <BoxView Background="{StaticResource Gradient1}" />
                <BoxView Background="{StaticResource Gradient2}" />
                <BoxView Background="{StaticResource Gradient3}" />
                <BoxView Background="{StaticResource Gradient4}" />
                <BoxView Background="{StaticResource Gradient1}" />
                <BoxView Background="{StaticResource Gradient2}" />
                <BoxView Background="{StaticResource Gradient3}" />
                <BoxView Background="{StaticResource Gradient4}" />
                <BoxView Background="{StaticResource Gradient1}" />
                <BoxView Background="{StaticResource Gradient2}" />
                <BoxView Background="{StaticResource Gradient3}" />
                <BoxView Background="{StaticResource Gradient4}" />

            </VerticalStackLayout>
        </ScrollView>
        <Label
            Grid.Row="2"
            Margin="12"
            Style="{StaticResource Large}"
            Text="Footer" />
    </Grid>
</ContentPage>