<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.Layouts.LayoutPlayground"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="This"
    SizeChanged="OnSizeChanged">
    <Grid>
        <toolkit:DockLayout ShouldExpandLastChild="True">
            <Border
                x:Name="PanelBorder"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}"
                StrokeThickness="0"
                toolkit:DockLayout.DockPosition="Bottom">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Grid
                        x:Name="SplitGrip"
                        HeightRequest="0"
                        IsVisible="False">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSplitPan" />
                            <PointerGestureRecognizer PointerEntered="OnSplitEntered" PointerExited="OnSplitExited" />
                        </Grid.GestureRecognizers>
                        <Border
                            BackgroundColor="#8E8E93"
                            HeightRequest="5"
                            HorizontalOptions="Center"
                            InputTransparent="True"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="2" />
                            </Border.StrokeShape>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
                        <Grid ColumnSpacing="8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeaderTapped" />
                            </Grid.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    Text="{Binding Source={x:Reference This}, Path=ExpandGlyph, x:DataType=layouts:LayoutPlayground}"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    IsVisible="{Binding Source={x:Reference This}, Path=ShowTitle, x:DataType=layouts:LayoutPlayground}"
                                    LineBreakMode="NoWrap"
                                    Text="{Binding Source={x:Reference This}, Path=Title, x:DataType=layouts:LayoutPlayground}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <!--  24 matches the info buttons in the cards: 12 scrollbar, 4 card margin, 8 card padding.  -->
                        <layouts:InfoControl
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            HorizontalOptions="End"
                            InfoTapped="OnAboutTapped"
                            IsVisible="{Binding Source={x:Reference This}, Path=ShowAbout, x:DataType=layouts:LayoutPlayground}"
                            Text="{Binding Source={x:Reference This}, Path=AboutText, x:DataType=layouts:LayoutPlayground}"
                            Title="{Binding Source={x:Reference This}, Path=AboutTitle, x:DataType=layouts:LayoutPlayground}"
                            VerticalOptions="Center" />
                    </Grid>
                    <ContentView
                        x:Name="ToolbarHost"
                        Grid.Row="2"
                        Margin="0,0,24,8"
                        IsVisible="{Binding Source={x:Reference This}, Path=ShowToolbar, x:DataType=layouts:LayoutPlayground}" />
                    <ScrollView
                        Grid.Row="3"
                        IsVisible="{Binding Source={x:Reference This}, Path=IsExpanded, x:DataType=layouts:LayoutPlayground}">
                        <!--  Right margin keeps info buttons and add buttons clear of the overlay scrollbar, which still takes taps when it is hidden.  -->
                        <ContentView x:Name="PanelHost" Margin="0,0,12,0" />
                    </ScrollView>
                </Grid>
            </Border>
            <ContentView x:Name="CanvasHost" />
        </toolkit:DockLayout>
        <!--  The info banner floats over the page; it does not take layout space.  -->
        <Border
            Margin="8,8,8,0"
            Padding="12,8"
            BackgroundColor="#0A84FF"
            IsVisible="{Binding Source={x:Reference This}, Path=HasInfo, x:DataType=layouts:LayoutPlayground}"
            StrokeThickness="0"
            VerticalOptions="Start">
            <Border.Shadow>
                <Shadow Opacity="0.35" Radius="8" Offset="0,2" />
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        Text="{Binding Source={x:Reference This}, Path=InfoTitle, x:DataType=layouts:LayoutPlayground}"
                        TextColor="White" />
                    <Label Text="{Binding Source={x:Reference This}, Path=InfoText, x:DataType=layouts:LayoutPlayground}" TextColor="White" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Clicked="OnDismissInfo"
                    FontSize="20"
                    HeightRequest="32"
                    MinimumHeightRequest="32"
                    MinimumWidthRequest="32"
                    Text="✕"
                    TextColor="White"
                    VerticalOptions="Start"
                    WidthRequest="32" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
