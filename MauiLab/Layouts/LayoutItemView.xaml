<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.Layouts.LayoutItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    x:Name="This"
    x:DataType="layouts:LayoutItem"
    HeightRequest="{Binding HeightRequest}"
    HorizontalOptions="{Binding HorizontalOptions}"
    Margin="{Binding Margin}"
    VerticalOptions="{Binding VerticalOptions}"
    WidthRequest="{Binding WidthRequest}"
    ZIndex="{Binding ZIndex}"
    AbsoluteLayout.LayoutBounds="{Binding Bounds}"
    AbsoluteLayout.LayoutFlags="{Binding Flags}"
    FlexLayout.AlignSelf="{Binding AlignSelf}"
    FlexLayout.Grow="{Binding Grow}"
    FlexLayout.Order="{Binding Order}"
    FlexLayout.Shrink="{Binding Shrink}"
    Grid.Column="{Binding Column}"
    Grid.ColumnSpan="{Binding ColumnSpan}"
    Grid.Row="{Binding Row}"
    Grid.RowSpan="{Binding RowSpan}"
    layouts:RadialLayout.Angle="{Binding Angle}">
    <ContentView.Resources>
        <layouts:KindMatchConverter x:Key="KindMatch" />
    </ContentView.Resources>
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTapped" />
    </ContentView.GestureRecognizers>

    <Grid>
        <Grid
            Opacity="{Binding Opacity}"
            Rotation="{Binding Rotation}"
            layouts:EllipseClip.IsClipped="{Binding IsClipped}">
            <Border
                BackgroundColor="{Binding Color}"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Rectangle}"
                StrokeThickness="0" />
            <Ellipse
                Fill="{Binding Color}"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Ellipse}" />
            <Polygon
                Aspect="Fill"
                Fill="{Binding Color}"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Triangle}"
                Points="50,0 100,100 0,100" />
            <Polygon
                Aspect="Fill"
                Fill="{Binding Color}"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Star}"
                Points="50,0 61.8,33.8 97.6,34.5 69,56.2 79.4,90.5 50,70 20.6,90.5 31,56.2 2.4,34.5 38.2,33.8" />
            <Image
                Aspect="AspectFit"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Image}"
                Source="{Binding ImageName}" />
            <Border
                BackgroundColor="{Binding Color}"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Panel}"
                Padding="8"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Name" />
                    <Entry Text="{Binding Text}" />
                </VerticalStackLayout>
            </Border>
            <Border
                BackgroundColor="Transparent"
                IsVisible="{Binding Kind, Converter={StaticResource KindMatch}, ConverterParameter=Stack}"
                Padding="6"
                Stroke="{Binding Color}"
                StrokeDashArray="4,3"
                StrokeThickness="2">
                <Grid>
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Children}"
                        IsVisible="{Binding IsVertical}"
                        Spacing="{Binding Spacing}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="layouts:LayoutItem">
                                <layouts:LayoutItemView />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <HorizontalStackLayout
                        BindableLayout.ItemsSource="{Binding Children}"
                        IsVisible="{Binding IsHorizontal}"
                        Spacing="{Binding Spacing}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="layouts:LayoutItem">
                                <layouts:LayoutItemView />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
        <Border
            BackgroundColor="Transparent"
            InputTransparent="True"
            IsVisible="{Binding IsSelected}"
            Stroke="Black"
            StrokeThickness="2" />
    </Grid>
</ContentView>
