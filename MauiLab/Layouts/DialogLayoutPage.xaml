<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Layouts.DialogLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:colors="clr-namespace:MauiLab.Colors"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    Title="Dialog Layout"
    x:DataType="layouts:DialogLayoutPageModel">
    <ContentPage.Resources>
        <DataTemplate x:Key="ColorItemTemplate" x:DataType="colors:ColorModel">
            <HorizontalStackLayout>
                <BoxView
                    Margin="4"
                    BackgroundColor="{Binding Color}"
                    HeightRequest="30"
                    WidthRequest="60"
                    Color="{Binding Color}" />
                <Label Margin="4" Text="{Binding Name}" />
            </HorizontalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>
    <Grid x:Name="LayersGrid">
        <Grid
            x:Name="LayoutGrid"
            Margin="-1"
            ColumnDefinitions="*,4*,*"
            ColumnSpacing="48"
            RowDefinitions="*,4*,*"
            RowSpacing="48">
            <!--  Rows. These paint the cells and do not contribute a size.  -->
            <layouts:CellWash
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Opacity="0.25"
                Color="Magenta" />
            <layouts:CellWash
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Opacity="0.25"
                Color="Yellow" />
            <layouts:CellWash
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Opacity="0.25"
                Color="Cyan" />
            <!--  Columns  -->
            <layouts:CellWash
                Grid.RowSpan="3"
                Grid.Column="0"
                Opacity="0.25"
                Color="Red" />
            <layouts:CellWash
                Grid.RowSpan="3"
                Grid.Column="1"
                Opacity="0.25"
                Color="Green" />
            <layouts:CellWash
                Grid.RowSpan="3"
                Grid.Column="2"
                Opacity="0.25"
                Color="Blue" />
            <!--  Center  -->
            <Border
                x:Name="Panel"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalOptions="Center"
                Style="{StaticResource floating-panel}"
                VerticalOptions="Start">
                <Grid RowDefinitions="Auto,*">
                    <Label
                        Grid.Row="0"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Medium}"
                        Text="{Binding Title}"
                        TextColor="{AppThemeBinding Default={StaticResource DarkText},
                                                    Dark={StaticResource LightText}}"
                        VerticalOptions="Start" />
                    <CollectionView
                        x:Name="CollectionView"
                        Grid.Row="1"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemTemplate="{StaticResource ColorItemTemplate}"
                        ItemsSource="{Binding Colors}"
                        MaximumWidthRequest="320"
                        SelectionMode="Single" />
                </Grid>
            </Border>
        </Grid>

        <!--  Layout Levers  -->
        <ScrollView
            Grid.RowSpan="2"
            HorizontalOptions="Start"
            Orientation="Vertical"
            VerticalOptions="Start">

            <VerticalStackLayout>
                <layouts:LayoutLevers Title="Panel" BindingContext="{Binding Source={x:Reference Panel}}" />
                <layouts:LayoutLevers Title="CollectionView" BindingContext="{Binding Source={x:Reference CollectionView}}" />
            </VerticalStackLayout>

        </ScrollView>
    </Grid>
</ContentPage>