<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Layouts.DialogLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:colors="clr-namespace:MauiLab.Colors"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    Title="Dialog Layout"
    x:DataType="layouts:DialogLayoutPageModel"
    BackgroundColor="White">
    <Grid
        Margin="-1"
        ColumnDefinitions="*,Auto,*"
        ColumnSpacing="8"
        HorizontalOptions="Fill"
        RowDefinitions="2*,Auto,5*"
        RowSpacing="8"
        VerticalOptions="Fill">
        <!--  Rows  -->
        <Rectangle
            Grid.Row="0"
            Grid.ColumnSpan="3"
            BackgroundColor="Magenta"
            Opacity="0.25" />
        <Rectangle
            Grid.Row="1"
            Grid.ColumnSpan="3"
            BackgroundColor="Yellow"
            Opacity="0.25" />
        <Rectangle
            Grid.Row="2"
            Grid.ColumnSpan="3"
            BackgroundColor="CYan"
            Opacity="0.25" />
        <!--  Columns  -->
        <Rectangle
            Grid.RowSpan="3"
            Grid.Column="0"
            BackgroundColor="Red"
            Opacity="0.25" />
        <Rectangle
            Grid.RowSpan="3"
            Grid.Column="1"
            BackgroundColor="Green"
            Opacity="0.25" />
        <Rectangle
            Grid.RowSpan="3"
            Grid.Column="2"
            BackgroundColor="Blue"
            Opacity="0.25" />
        <!--  Center  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="15"
            Padding="10"
            BackgroundColor="Gray"
            HorizontalOptions="Center"
            Opacity="1"
            Stroke="Black"
            StrokeThickness="1"
            VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Radius="10" />
            </Border.Shadow>
            <Grid
                BackgroundColor="White"
                HorizontalOptions="Center"
                RowDefinitions="Auto,*,Auto"
                VerticalOptions="Center">
                <Label
                    Grid.Row="0"
                    FontSize="Medium"
                    HorizontalOptions="Center"
                    Text="{Binding Title}"
                    TextColor="Black"
                    VerticalOptions="Start" />
                <CollectionView
                    Grid.Row="1"
                    HorizontalOptions="Center"
                    IsVisible="True"
                    ItemsSource="{Binding Colors}"
                    VerticalOptions="Center"
                    VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="colors:ColorModel">
                            <HorizontalStackLayout IsVisible="True">
                                <BoxView
                                    Margin="4"
                                    HeightRequest="30"
                                    VerticalOptions="Center"
                                    WidthRequest="60"
                                    Color="{Binding Color}" />
                                <Label
                                    Margin="4"
                                    Text="{Binding Name}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button
                    Grid.Row="2"
                    Margin="8"
                    Text="OK" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>