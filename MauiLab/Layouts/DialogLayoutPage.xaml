<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiLab.Layouts.DialogLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:colors="clr-namespace:MauiLab.Colors"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    Title="Dialog Layout"
    x:DataType="layouts:DialogLayoutPageModel"
    BackgroundColor="White">
    <Grid
        Margin="-1"
        ColumnDefinitions="*,Auto,*"
        ColumnSpacing="8"
        RowDefinitions="2*,Auto,5*"
        RowSpacing="8">
        <!--  Rows  -->
        <Rectangle
            Grid.Row="0"
            Grid.ColumnSpan="3"
            BackgroundColor="Blue"
            Opacity="0.25" />
        <Rectangle
            Grid.Row="1"
            Grid.ColumnSpan="3"
            BackgroundColor="Blue"
            Opacity="0.25" />
        <Rectangle
            Grid.Row="2"
            Grid.ColumnSpan="3"
            BackgroundColor="Blue"
            Opacity="0.25" />
        <!--  Columns  -->
        <Rectangle
            Grid.RowSpan="3"
            Grid.Column="0"
            BackgroundColor="Red"
            Opacity="0.25" />
        <Rectangle
            Grid.RowSpan="3"
            Grid.Column="1"
            BackgroundColor="Red"
            Opacity="0.25" />
        <Rectangle
            Grid.RowSpan="3"
            Grid.Column="2"
            BackgroundColor="Red"
            Opacity="0.25" />
        <!--  Center  -->
        <Grid Grid.Row="1" Grid.Column="1" />
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="15"
            Padding="10"
            BackgroundColor="LightGoldenrodYellow"
            MaximumHeightRequest="500"
            Opacity="1"
            Stroke="Black"
            StrokeThickness="1">
            <Border.Shadow>
                <Shadow Radius="10" />
            </Border.Shadow>
            <Grid BackgroundColor="White" RowDefinitions="Auto,*,Auto">
                <Label
                    Grid.Row="0"
                    FontSize="Small"
                    HorizontalOptions="Center"
                    Text="{Binding Title}"
                    TextColor="Black"
                    VerticalOptions="Center" />
                <CollectionView
                    Grid.Row="1"
                    IsVisible="True"
                    ItemsSource="{Binding Colors}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="colors:ColorModel">
                            <HorizontalStackLayout IsVisible="True">
                                <BoxView
                                    Margin="4"
                                    HeightRequest="30"
                                    VerticalOptions="Center"
                                    WidthRequest="60"
                                    Color="{Binding Color}" />
                                <Label
                                    Margin="4"
                                    Text="{Binding Name}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button
                    Grid.Row="2"
                    Margin="8"
                    Text="OK" />
            </Grid>

        </Border>
    </Grid>
</ContentPage>