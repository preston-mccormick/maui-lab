<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiLab.Layouts.LayoutLevers"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layouts="clr-namespace:MauiLab.Layouts"
    x:DataType="View">
    <ContentView.Resources>
        <Style TargetType="Entry">
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="HorizontalTextAlignment" Value="End" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Switch">
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <layouts:LayoutOptionsToStringConverter x:Key="LayoutOptionsConverter" />
    </ContentView.Resources>

    <VerticalStackLayout Spacing="0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="Height" />
            <Label
                Grid.Column="1"
                LineBreakMode="NoWrap"
                Text="{Binding Height, StringFormat='{0:N2}'}" />
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="Width" />
            <Label
                Grid.Column="1"
                LineBreakMode="NoWrap"
                Text="{Binding Width, StringFormat='{0:N2}'}" />
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Label Text="WidthRequest" />
            <layouts:NumberLever
                Grid.Column="1"
                HasUnset="True"
                Maximum="480"
                Minimum="0"
                Value="{Binding WidthRequest}" />
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Label Text="MinimumWidthRequest" />
            <layouts:NumberLever
                Grid.Column="1"
                HasUnset="True"
                Maximum="480"
                Minimum="0"
                Value="{Binding MinimumWidthRequest}" />
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Label Text="MaximumWidthRequest" />
            <layouts:NumberLever
                Grid.Column="1"
                HasUnbounded="True"
                Maximum="480"
                Minimum="0"
                Value="{Binding MaximumWidthRequest}" />
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Label Text="HeightRequest" />
            <layouts:NumberLever
                Grid.Column="1"
                HasUnset="True"
                Maximum="480"
                Minimum="0"
                Value="{Binding HeightRequest}" />
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Text="HorizontalOptions" />
            <Picker
                Grid.Column="1"
                SelectedItem="{Binding HorizontalOptions, Converter={StaticResource LayoutOptionsConverter}}">
                <Picker.Items>
                    <x:String>Start</x:String>
                    <x:String>Center</x:String>
                    <x:String>End</x:String>
                    <x:String>Fill</x:String>
                    <x:String>StartAndExpand</x:String>
                    <x:String>CenterAndExpand</x:String>
                    <x:String>EndAndExpand</x:String>
                    <x:String>FillAndExpand</x:String>
                </Picker.Items>
            </Picker>
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Text="VerticalOptions" />
            <Picker
                Grid.Column="1"
                SelectedItem="{Binding VerticalOptions, Converter={StaticResource LayoutOptionsConverter}}">
                <Picker.Items>
                    <x:String>Start</x:String>
                    <x:String>Center</x:String>
                    <x:String>End</x:String>
                    <x:String>Fill</x:String>
                    <x:String>StartAndExpand</x:String>
                    <x:String>CenterAndExpand</x:String>
                    <x:String>EndAndExpand</x:String>
                    <x:String>FillAndExpand</x:String>
                </Picker.Items>
            </Picker>
        </Grid>
        <layouts:SettingSeparator />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="IsVisible" />
            <Switch Grid.Column="1" HorizontalOptions="End" IsToggled="{Binding IsVisible}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
