<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiCustomControls.Views.MenuButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiCustomControls.Views"
    x:DataType="views:MenuButton">
    <VerticalStackLayout Spacing="5">
        <Button
            HorizontalOptions="Start"
            Text="{Binding Text}" />
        <!--  Context Menu  -->
        <VerticalStackLayout
            HorizontalOptions="Start"
            IsVisible="{Binding IsMenuVisible}">
            <views:MenuItem
                Icon="steelpick.png"
                TapCommand="{Binding MenuItemTappedCommand}"
                TapCommandParameter="{Binding Source={RelativeSource Self}, Path=Text}"
                Text="Mine" />
            <views:MenuItem
                Icon="stonehoe.png"
                TapCommand="{Binding MenuItemTappedCommand}"
                Text="Farm" />
            <views:MenuItem
                Icon="diamondsword.png"
                TapCommand="{Binding MenuItemTappedCommand}"
                Text="Fight" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
